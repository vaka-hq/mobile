diff --git a/android/src/main/java/expo/modules/audio/StreamCache.kt b/android/src/main/java/expo/modules/audio/StreamCache.kt
new file mode 100644
index 0000000000000000000000000000000000000000..637b353eaf9b820b2b6b8369c30b527b8734787f
--- /dev/null
+++ b/android/src/main/java/expo/modules/audio/StreamCache.kt
@@ -0,0 +1,70 @@
+package expo.modules.audio
+
+import android.content.Context
+import androidx.core.net.toUri
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.database.StandaloneDatabaseProvider
+import androidx.media3.datasource.DataSource
+import androidx.media3.datasource.DataSpec
+import androidx.media3.datasource.cache.CacheDataSource
+import androidx.media3.datasource.cache.CacheKeyFactory
+import androidx.media3.datasource.cache.CacheWriter
+import androidx.media3.datasource.cache.LeastRecentlyUsedCacheEvictor
+import androidx.media3.datasource.cache.SimpleCache
+import java.io.File
+
+/**
+ * Vaka: streamed audio kept on disk, so a seek into anything already fetched plays without the
+ * network, including audio fetched ahead of a jump by [prefetch]. Streams are keyed without their
+ * query, since expiring links to the same file differ only in their token.
+ */
+@UnstableApi
+internal object StreamCache {
+  private const val MAX_BYTES = 256L * 1024 * 1024
+
+  @Volatile private var cache: SimpleCache? = null
+
+  val keyFactory = CacheKeyFactory { spec -> spec.uri.buildUpon().clearQuery().build().toString() }
+
+  fun get(context: Context): SimpleCache = cache ?: synchronized(this) {
+    cache ?: SimpleCache(
+      File(context.cacheDir, "vaka-stream-cache"),
+      LeastRecentlyUsedCacheEvictor(MAX_BYTES),
+      StandaloneDatabaseProvider(context)
+    ).also { cache = it }
+  }
+
+  fun factory(context: Context, upstream: DataSource.Factory): DataSource.Factory =
+    CacheDataSource.Factory()
+      .setCache(get(context))
+      .setUpstreamDataSourceFactory(upstream)
+      .setCacheKeyFactory(keyFactory)
+      .setFlags(CacheDataSource.FLAG_IGNORE_CACHE_ON_ERROR)
+
+  /** Bytes of audio held on disk. */
+  fun size(context: Context): Long = get(context).cacheSpace
+
+  /**
+   * Removes every stream from the disk cache, such as when the listener clears cached data. Audio
+   * being fetched right now finishes into the emptied cache.
+   */
+  fun clear(context: Context) {
+    val cache = get(context)
+
+    for (key in cache.keys.toList()) {
+      cache.removeResource(key)
+    }
+  }
+
+  /** Downloads `length` bytes from `position` into the cache; blocking, so call off the main thread. */
+  fun prefetch(context: Context, upstream: DataSource.Factory, url: String, position: Long, length: Long) {
+    val spec = DataSpec.Builder()
+      .setUri(url.toUri())
+      .setPosition(position.coerceAtLeast(0))
+      .setLength(length)
+      .build()
+    val source = factory(context, upstream).createDataSource() as CacheDataSource
+
+    CacheWriter(source, spec, null, null).cache()
+  }
+}
